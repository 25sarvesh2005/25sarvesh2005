<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 172" width="840" height="172" role="img" aria-labelledby="hero-title-{{ mode }} hero-desc-{{ mode }}">
  <title id="hero-title-{{ mode }}">{{ report.display_name }} (@{{ report.username }}) — Cyber-Citadel Profile Banner</title>
  <desc id="hero-desc-{{ mode }}">Level {{ report.level }} {{ report.level_title }} with {{ report.xp }} verified XP and {{ report.total_contributions }} GitHub contributions.</desc>
  <defs>
    <linearGradient id="hero-sky-{{ mode }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="{{ theme.bg_stage_top }}"/>
      <stop offset="100%" stop-color="{{ theme.bg_stage_bot }}"/>
    </linearGradient>
    <radialGradient id="hero-glow-l-{{ mode }}" cx="18%" cy="48%" r="45%">
      <stop offset="0%" stop-color="{{ theme.accent_primary }}" stop-opacity="0.24"/>
      <stop offset="100%" stop-color="{{ theme.accent_primary }}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="hero-glow-r-{{ mode }}" cx="82%" cy="40%" r="42%">
      <stop offset="0%" stop-color="{{ theme.accent_arcane }}" stop-opacity="0.22"/>
      <stop offset="100%" stop-color="{{ theme.accent_arcane }}" stop-opacity="0"/>
    </radialGradient>
    <pattern id="hero-scan-{{ mode }}" width="4" height="4" patternUnits="userSpaceOnUse">
      <rect x="0" y="0" width="4" height="1" fill="{{ theme.scanline }}" opacity="0.1"/>
    </pattern>
    <clipPath id="hero-stage-clip-{{ mode }}">
      <rect x="8" y="8" width="824" height="156" rx="3"/>
    </clipPath>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .blink-led { animation: led 1.6s steps(2, end) infinite; }
      .twinkle-a { animation: twinkle 2.3s steps(2, end) infinite; }
      .twinkle-b { animation: twinkle 3.1s steps(2, end) 0.9s infinite; }
      .scan-beam { animation: beam 5.5s linear infinite; }
      @keyframes led { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
      @keyframes twinkle { 0%, 100% { opacity: 0.95; } 50% { opacity: 0.22; } }
      @keyframes beam {
        0% { transform: translateY(-6px); opacity: 0; }
        12%, 88% { opacity: 0.28; }
        100% { transform: translateY(156px); opacity: 0; }
      }
    </style>
  </defs>

  <!-- Outer Pixel Cartridge Frame -->
  <rect x="2" y="2" width="836" height="168" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="2"/>
  <rect x="8" y="8" width="824" height="156" rx="3" fill="url(#hero-sky-{{ mode }})" stroke="{{ theme.border }}" stroke-width="1.2"/>

  <g clip-path="url(#hero-stage-clip-{{ mode }})">
    <rect x="8" y="8" width="824" height="156" fill="url(#hero-glow-l-{{ mode }})"/>
    <rect x="8" y="8" width="824" height="156" fill="url(#hero-glow-r-{{ mode }})"/>

    <!-- Stars / Sky Celestial -->
    {% if mode == "dark" %}
    <g shape-rendering="crispEdges" fill="{{ theme.star }}">
      <rect class="twinkle-a" x="410" y="24" width="2" height="2"/><rect class="twinkle-b" x="456" y="40" width="3" height="3"/>
      <rect class="twinkle-a" x="520" y="20" width="2" height="2"/><rect class="twinkle-b" x="598" y="34" width="3" height="3"/>
      <rect class="twinkle-a" x="646" y="18" width="2" height="2"/><rect class="twinkle-b" x="720" y="42" width="3" height="3"/>
      <rect class="twinkle-a" x="802" y="26" width="2" height="2"/>
    </g>
    {% endif %}
    <g shape-rendering="crispEdges">
      {% for r in celestial_rects %}
      <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
      {% endfor %}
      {% for r in cloud_rects %}
      <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
      {% endfor %}
    </g>

    <!-- Stepped Pixel Cyber-Citadel Skyline -->
    <g shape-rendering="crispEdges" fill="{{ theme.horizon }}">
      <rect x="8" y="114" width="824" height="50"/>
      <rect x="18" y="96" width="36" height="18"/><rect x="66" y="82" width="28" height="32"/>
      <rect x="108" y="100" width="44" height="14"/><rect x="530" y="98" width="34" height="16"/>
      <rect x="576" y="80" width="26" height="34"/><rect x="614" y="90" width="42" height="24"/>
      <rect x="668" y="72" width="32" height="42"/><rect x="712" y="94" width="38" height="20"/>
      <rect x="762" y="84" width="26" height="30"/><rect x="796" y="102" width="36" height="12"/>
    </g>
    <!-- Blinking Citadel Window LEDs -->
    <g shape-rendering="crispEdges">
      <rect class="twinkle-a" x="74" y="88" width="4" height="4" fill="{{ theme.accent_primary }}"/>
      <rect class="twinkle-b" x="84" y="98" width="4" height="4" fill="{{ theme.accent_amber }}"/>
      <rect class="twinkle-b" x="584" y="88" width="4" height="4" fill="{{ theme.accent_signal }}"/>
      <rect class="twinkle-a" x="584" y="100" width="4" height="4" fill="{{ theme.accent_primary }}"/>
      <rect class="twinkle-a" x="628" y="96" width="4" height="4" fill="{{ theme.accent_amber }}"/>
      <rect class="twinkle-b" x="676" y="80" width="4" height="4" fill="{{ theme.accent_primary }}"/>
      <rect class="twinkle-a" x="688" y="90" width="4" height="4" fill="{{ theme.accent_boss }}"/>
      <rect class="twinkle-b" x="770" y="92" width="4" height="4" fill="{{ theme.accent_signal }}"/>
    </g>

    <!-- CRT Scanline Texture + Animated Laser Sweep -->
    <rect x="8" y="8" width="824" height="156" fill="url(#hero-scan-{{ mode }})"/>
    <rect class="scan-beam" x="8" y="8" width="824" height="3" fill="{{ theme.accent_primary }}"/>
  </g>

  <!-- Corner Pixel Brackets & Rivets -->
  <g shape-rendering="crispEdges" fill="{{ theme.accent_primary }}">
    <rect x="4" y="4" width="14" height="3"/><rect x="4" y="4" width="3" height="14"/>
    <rect x="822" y="4" width="14" height="3"/><rect x="833" y="4" width="3" height="14"/>
    <rect x="4" y="165" width="14" height="3"/><rect x="4" y="154" width="3" height="14"/>
    <rect x="822" y="165" width="14" height="3"/><rect x="833" y="154" width="3" height="14"/>
  </g>

  <!-- Top Telemetry Line -->
  <rect class="blink-led" x="24" y="21" width="7" height="7" rx="1" fill="{{ theme.accent_signal }}"/>
  <text x="38" y="28" class="mono" font-size="10.5" font-weight="700" fill="{{ theme.accent_signal }}" letter-spacing="0.8">SYS.ONLINE // VERIFIED TELEMETRY PROFILE</text>
  <text x="814" y="28" text-anchor="end" class="mono" font-size="10" font-weight="600" fill="{{ theme.text_muted }}">@{{ report.username }} · SYNC {{ sync_date }}</text>

  <!-- Hero Display Name + Pixel Shadow -->
  <text x="26" y="72" class="sans" font-size="30" font-weight="800" fill="{{ theme.border }}" opacity="0.55" letter-spacing="1.4">{{ report.display_name.upper() }}</text>
  <text x="24" y="70" class="sans" font-size="30" font-weight="800" fill="{{ theme.text_primary }}" letter-spacing="1.4">{{ report.display_name.upper() }}</text>
  <text x="25" y="92" class="mono" font-size="11.5" font-weight="600" fill="{{ theme.accent_primary }}" letter-spacing="0.6">{{ report.level_title.upper() }} · VERIFIABLE AI PIPELINES · DETERMINISTIC SYSTEMS</text>

  <!-- Bottom 5 Live Stat HUD Chips -->
  {% set chips = [
    ("RANK / LVL", "LVL " ~ report.level, theme.accent_primary),
    ("VERIFIED XP", "{:,}".format(report.xp) ~ " XP", theme.accent_amber),
    ("ACTIVITY", report.total_contributions ~ " CONTRIBS", theme.accent_signal),
    ("RELIABILITY", report.ci_repos ~ " CI · " ~ report.documented_repos ~ " DOCS", theme.accent_arcane),
    ("BADGE CASE", report.unlocked_count ~ " / " ~ report.total_quests ~ " QUESTS", theme.accent_boss)
  ] %}
  {% for label, value, color in chips %}
  {% set cx = 24 + loop.index0 * 160 %}
  <rect x="{{ cx }}" y="110" width="150" height="42" rx="3" fill="{{ theme.bg_chip }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <rect x="{{ cx }}" y="110" width="150" height="3" rx="1" fill="{{ color }}"/>
  <text x="{{ cx + 10 }}" y="126" class="mono" font-size="8.5" font-weight="700" fill="{{ theme.text_muted }}">{{ label }}</text>
  <text x="{{ cx + 10 }}" y="143" class="mono" font-size="12" font-weight="700" fill="{{ color }}">{{ value }}</text>
  {% endfor %}
</svg>
