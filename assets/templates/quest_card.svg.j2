<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 408 124" width="408" height="124" role="img" aria-labelledby="quest-title-{{ card.slug }}-{{ mode }}">
  <title id="quest-title-{{ card.slug }}-{{ mode }}">{{ card.title }} — {{ card.line1 }}</title>
  <defs>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .pulse { animation: pulse 1.8s steps(2, end) infinite; }
      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    </style>
  </defs>

  <!-- Pixel Cartridge Shell + Top Grip Notch -->
  <rect x="2" y="4" width="404" height="118" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="148" y="2" width="112" height="7" rx="1.5" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <rect x="6" y="10" width="4" height="106" rx="1.5" fill="{{ accent }}"/>

  <!-- Left Pixel Emblem Socket -->
  <rect x="17" y="22" width="54" height="54" rx="3" fill="{{ theme.bg_stage }}" stroke="{{ theme.border }}" stroke-width="1.3"/>
  <g shape-rendering="crispEdges">
    {% for r in card.sprite_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- Title + Live Verified Status Beacons -->
  <text x="82" y="34" class="sans" font-size="14.5" font-weight="700" fill="{{ theme.text_primary }}">{{ card.title }}</text>
  {% if card.live_url %}
  <rect x="334" y="21" width="58" height="17" rx="2" fill="{{ theme.bg_panel }}" stroke="{{ theme.accent_signal }}" stroke-width="1.2"/>
  <rect class="pulse" x="340" y="27" width="5" height="5" fill="{{ theme.accent_signal }}"/>
  <text x="350" y="33" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_signal }}">LIVE</text>
  {% elif card.has_ci %}
  <rect x="328" y="21" width="64" height="17" rx="2" fill="{{ theme.bg_panel }}" stroke="{{ accent }}" stroke-width="1.2"/>
  <text x="360" y="33" text-anchor="middle" class="mono" font-size="9" font-weight="700" fill="{{ accent }}">CI PASS</text>
  {% elif card.has_readme %}
  <rect x="340" y="21" width="52" height="17" rx="2" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.1"/>
  <text x="366" y="33" text-anchor="middle" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_muted }}">DOCS</text>
  {% endif %}

  <!-- Concise Architecture Lines -->
  <text x="82" y="54" class="sans" font-size="11" font-weight="600" fill="{{ theme.text_muted }}">{{ card.line1 }}</text>
  <text x="82" y="70" class="sans" font-size="10.5" fill="{{ theme.text_subtle }}">{{ card.line2 }}</text>

  <!-- Cartridge Footer -->
  <rect x="16" y="88" width="376" height="24" rx="2.5" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1"/>
  <rect x="24" y="97" width="6" height="6" rx="1" fill="{{ accent }}"/>
  <text x="35" y="103" class="mono" font-size="9" font-weight="600" fill="{{ theme.text_primary }}">{{ card.stack_label }}</text>
  <text x="384" y="103" text-anchor="end" class="mono" font-size="8.5" font-weight="700" fill="{{ accent }}">OPEN QUEST ▶</text>
</svg>
