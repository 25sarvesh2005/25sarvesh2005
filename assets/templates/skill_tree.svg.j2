<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 700" width="840" height="700" role="img" aria-labelledby="skilltree-title-{{ mode }} skilltree-desc-{{ mode }}">
  <title id="skilltree-title-{{ mode }}">Talent Constellation &amp; Stat Matrix — @{{ report.username }}</title>
  <desc id="skilltree-desc-{{ mode }}">Full-width 6-sector RPG talent constellation across {{ total_skill_count }} verified technologies with repo depth, sector mastery, capstone keystones, and architecture verification.</desc>
  <defs>
    <clipPath id="constellation-clip-{{ mode }}">
      <rect x="14" y="48" width="812" height="490" rx="5"/>
    </clipPath>
    <radialGradient id="hub-aura-{{ mode }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="{{ grade_color }}" stop-opacity="0.30"/>
      <stop offset="65%" stop-color="{{ theme.accent_arcane }}" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="{{ theme.bg_card }}" stop-opacity="0"/>
    </radialGradient>
    {% for w in wedges %}
    <radialGradient id="wedge-glow-{{ w.key }}-{{ mode }}" cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="360" gradientUnits="userSpaceOnUse">
      <stop offset="10%" stop-color="{{ w.accent }}" stop-opacity="{{ w.beam_alpha }}"/>
      <stop offset="56%" stop-color="{{ w.accent }}" stop-opacity="{{ w.beam_mid }}"/>
      <stop offset="94%" stop-color="{{ w.accent }}" stop-opacity="0"/>
    </radialGradient>
    {% endfor %}
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .astrolabe-spin { animation: orbit-spin 48s linear infinite; }
      .star-a { animation: star-twinkle 3.2s ease-in-out infinite; }
      .star-b { animation: star-twinkle 4.4s ease-in-out 1.4s infinite; }
      @keyframes orbit-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      @keyframes star-twinkle { 0%, 100% { opacity: 0.5; } 50% { opacity: 0.14; } }
    </style>
  </defs>

  <!-- Outer Frame & Clean Single-Line Header -->
  <rect x="2" y="2" width="836" height="696" rx="6" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="4" y="4" width="832" height="36" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="4" y1="40" x2="836" y2="40" stroke="{{ theme.border }}" stroke-width="1.2"/>

  <g shape-rendering="crispEdges">
    {% for r in header_ball %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <text x="34" y="26" class="mono" font-size="10.5" font-weight="700" fill="{{ theme.accent_amber }}">{{ "{:,}".format(report.xp) }} XP · {{ report.non_empty_owned_repos }} Repos</text>
  <text x="420" y="27" text-anchor="middle" class="sans" font-size="14" font-weight="800" letter-spacing="2.0" fill="{{ theme.text_primary }}">‹   TALENT TREE · @{{ report.username }}   ›</text>
  <text x="822" y="26" text-anchor="end" class="mono" font-size="10.5" font-weight="700" fill="{{ grade_color }}">{{ earned_pips }}/{{ max_pips }} Pips · Rank {{ report.grade }}</text>

  <!-- FULL-WIDTH SPACIOUS CONSTELLATION STAGE (812 x 490) -->
  <rect x="14" y="48" width="812" height="490" rx="5" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.6"/>

  <g clip-path="url(#constellation-clip-{{ mode }})">
    <!-- Subtle Sector Glow Beams -->
    {% for w in wedges %}
    <polygon points="{{ w.points }}" fill="url(#wedge-glow-{{ w.key }}-{{ mode }})"/>
    {% endfor %}

    {% if mode == "dark" %}
    <g fill="{{ theme.text_subtle }}">
      <circle class="star-a" cx="122" cy="128" r="1.4"/><circle class="star-b" cx="718" cy="126" r="1.5"/>
      <circle class="star-b" cx="754" cy="398" r="1.4"/><circle class="star-a" cx="98" cy="404" r="1.5"/>
      <circle class="star-a" cx="514" cy="68" r="1.3"/><circle class="star-b" cx="446" cy="512" r="1.3"/>
      <circle class="star-b" cx="84" cy="212" r="1.2"/><circle class="star-a" cx="732" cy="216" r="1.4"/>
      <circle class="star-a" cx="318" cy="488" r="1.3"/><circle class="star-b" cx="634" cy="112" r="1.3"/>
    </g>
    {% endif %}

    <!-- Orbital Concentric Rings -->
    <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="118" fill="none" stroke="{{ theme.border }}" stroke-width="0.8" stroke-dasharray="3,6" opacity="0.38"/>
    <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="218" fill="none" stroke="{{ theme.border }}" stroke-width="0.8" stroke-dasharray="3,7" opacity="0.26"/>

    <!-- Radial Sector Dividers -->
    {% for ray in divider_rays %}
    <line x1="{{ ray.x1 }}" y1="{{ ray.y1 }}" x2="{{ ray.x2 }}" y2="{{ ray.y2 }}" stroke="{{ theme.border }}" stroke-width="1" opacity="0.48"/>
    {% endfor %}

    <!-- Center Aura -->
    <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="86" fill="url(#hub-aura-{{ mode }})"/>

    <!-- Curved Inter-Branch Links -->
    {% for br in bridges %}
    <path d="{{ br.d }}" fill="none" stroke="{{ br.stroke }}" stroke-width="1" stroke-dasharray="4,5" opacity="{{ 0.36 if br.active else 0.16 }}"/>
    {% endfor %}

    <!-- Curved Bezier Constellation Paths -->
    {% for edge in edges %}
    {% if edge.active and not edge.synergy %}
    <path d="{{ edge.d }}" fill="none" stroke="{{ edge.stroke }}" stroke-width="5.2" opacity="0.16"/>
    {% endif %}
    <path d="{{ edge.d }}" fill="none" stroke="{{ edge.stroke }}" stroke-width="{{ 1.4 if edge.synergy else 2.2 }}" stroke-dasharray="{{ '4,4' if edge.synergy else 'none' }}" opacity="{{ 0.88 if edge.active else 0.32 }}"/>
    {% endfor %}

    <!-- Exact Curve-Midpoint Relay Dots -->
    {% for dot in joint_dots %}
    <circle cx="{{ dot.cx }}" cy="{{ dot.cy }}" r="2.8" fill="{{ dot.fill }}" opacity="{{ 0.88 if dot.active else 0.35 }}"/>
    {% endfor %}

    <!-- Corner Sector Labels -->
    {% for w in wedges %}
    <text x="{{ w.tag_x }}" y="{{ w.tag_y }}" text-anchor="{{ w.anchor }}" class="mono" font-size="9" font-weight="700" letter-spacing="0.8" fill="{{ w.accent }}" opacity="0.9">{{ w.title }}</text>
    {% endfor %}
  </g>

  <!-- Minimal Corner Progress Summary -->
  <text x="26" y="68" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.text_muted }}">Active: <tspan fill="{{ theme.text_primary }}">{{ active_skill_count }}/{{ total_skill_count }}</tspan></text>
  <text x="26" y="83" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.text_muted }}">Mastered: <tspan fill="{{ theme.accent_amber }}">{{ mastered_count }}/{{ total_skill_count }}</tspan></text>

  <!-- Large Central Astrolabe Core Seal (r=46) -->
  <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="46" fill="{{ theme.bg_panel }}" stroke="{{ grade_color }}" stroke-width="2.2"/>
  {% for tk in hub_ticks %}
  <line x1="{{ tk.x1 }}" y1="{{ tk.y1 }}" x2="{{ tk.x2 }}" y2="{{ tk.y2 }}" stroke="{{ theme.accent_amber }}" stroke-width="1.6" opacity="0.8"/>
  {% endfor %}
  <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="36" fill="{{ theme.bg_hud }}" stroke="{{ theme.accent_amber }}" stroke-width="1.2" opacity="0.88"/>
  <g transform="translate({{ hub_cx }}, {{ hub_cy }})">
    <g class="astrolabe-spin">
      <polygon points="-15,-26 30,0 -15,26" fill="none" stroke="{{ theme.accent_amber }}" stroke-width="1.2" opacity="0.58"/>
      <polygon points="15,-26 15,26 -30,0" fill="none" stroke="{{ grade_color }}" stroke-width="1.2" opacity="0.52"/>
    </g>
  </g>
  <circle cx="{{ hub_cx }}" cy="{{ hub_cy }}" r="20.5" fill="{{ theme.bg_panel }}" stroke="{{ grade_color }}" stroke-width="1.4"/>
  <text x="{{ hub_cx }}" y="{{ hub_cy + 5 }}" text-anchor="middle" class="sans" font-size="18" font-weight="800" fill="{{ grade_color }}">{{ report.grade }}</text>
  <text x="{{ hub_cx }}" y="{{ hub_cy + 16.5 }}" text-anchor="middle" class="mono" font-size="8" font-weight="700" fill="{{ theme.text_muted }}">Lv{{ report.level }}</text>

  <!-- 24 Large Clear Skill Nodes (15px Circle / 20px Octagon Capstone + Jewel Pips + Clear 2-Line Halo Labels) -->
  {% for node in nodes %}
    {% if node.is_capstone %}
      {% if node.active %}
      <polygon points="{{ node.octagon_pts }}" fill="none" stroke="{{ node.glow_color }}" stroke-width="5.5" opacity="0.22"/>
      {% endif %}
      <polygon points="{{ node.octagon_pts }}" fill="{{ theme.bg_panel }}" stroke="{{ node.ring_color }}" stroke-width="{{ 2.2 if node.active else 1.2 }}"/>
      <polygon points="{{ node.octagon_inner_pts }}" fill="{{ theme.bg_hud }}" stroke="{{ node.glow_color }}" stroke-width="1" opacity="0.7"/>
    {% else %}
      {% if node.active %}
      <circle cx="{{ node.x }}" cy="{{ node.y }}" r="{{ node.r + 4 }}" fill="none" stroke="{{ node.glow_color }}" stroke-width="4.4" opacity="0.20"/>
      {% endif %}
      <circle cx="{{ node.x }}" cy="{{ node.y }}" r="{{ node.r }}" fill="{{ theme.bg_panel }}" stroke="{{ node.ring_color }}" stroke-width="{{ 2.0 if node.active else 1.2 }}"/>
      <circle cx="{{ node.x }}" cy="{{ node.y }}" r="{{ node.r - 3.5 }}" fill="{{ theme.bg_hud }}" stroke="{{ node.glow_color }}" stroke-width="0.8" opacity="0.6"/>
    {% endif %}

    {% for pip in node.pips %}
    <circle cx="{{ pip.cx }}" cy="{{ pip.cy }}" r="2.8" fill="{{ pip.fill }}" stroke="{{ pip.stroke }}" stroke-width="0.9"/>
    {% endfor %}

    <path d="{{ node.icon_path }}" fill="none" stroke="{{ node.icon_color }}" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>

    <!-- Big Clear Halo-Stroked Name + Repo Count -->
    <text x="{{ node.x }}" y="{{ node.label_y }}" text-anchor="middle" class="sans" font-size="10.2" font-weight="700" fill="{{ theme.bg_hud }}" stroke="{{ theme.bg_hud }}" stroke-width="4" stroke-linejoin="round" opacity="0.94">{{ node.label_text }}</text>
    <text x="{{ node.x }}" y="{{ node.label_y }}" text-anchor="middle" class="sans" font-size="10.2" font-weight="700" fill="{{ node.label_color }}">{{ node.label_text }}</text>

    <text x="{{ node.x }}" y="{{ node.sub_y }}" text-anchor="middle" class="mono" font-size="8.2" font-weight="700" fill="{{ theme.bg_hud }}" stroke="{{ theme.bg_hud }}" stroke-width="3.2" stroke-linejoin="round" opacity="0.94">{{ node.sub_text }}</text>
    <text x="{{ node.x }}" y="{{ node.sub_y }}" text-anchor="middle" class="mono" font-size="8.2" font-weight="700" fill="{{ node.sub_color }}">{{ node.sub_text }}</text>
  {% endfor %}

  <!-- BOTTOM 3-PANEL HIGH-CLARITY STATS DOCK (812 x 140) -->
  <!-- Panel 1: ARCHITECTURE PROOF -->
  <rect x="14" y="546" width="264" height="140" rx="4" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <rect x="14" y="546" width="264" height="22" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="14" y1="568" x2="278" y2="568" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="24" y="561" class="sans" font-size="10" font-weight="800" letter-spacing="0.8" fill="{{ theme.text_primary }}">ARCHITECTURE PROOF</text>
  <text x="268" y="561" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ grade_color }}">RANK {{ report.grade }} ({{ report.grade_score }}/100)</text>

  <text x="24" y="587" class="mono" font-size="9" fill="{{ theme.text_muted }}">Specialty</text>
  <text x="142" y="587" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">Systems &amp; AI</text>
  <text x="156" y="587" class="mono" font-size="9" fill="{{ theme.text_muted }}">CI Gates</text>
  <text x="268" y="587" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_signal }}">{{ report.ci_repos }}/{{ report.non_empty_owned_repos }}</text>

  <text x="24" y="608" class="mono" font-size="9" fill="{{ theme.text_muted }}">Repos Built</text>
  <text x="142" y="608" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">{{ report.non_empty_owned_repos }} Public</text>
  <text x="156" y="608" class="mono" font-size="9" fill="{{ theme.text_muted }}">Docs Ready</text>
  <text x="268" y="608" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_signal }}">{{ report.documented_repos }}/{{ report.non_empty_owned_repos }}</text>

  <text x="24" y="629" class="mono" font-size="9" fill="{{ theme.text_muted }}">Test Suites</text>
  <text x="142" y="629" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">{{ report.total_test_files }} Files</text>
  <text x="156" y="629" class="mono" font-size="9" fill="{{ theme.text_muted }}">Docker</text>
  <text x="268" y="629" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_primary }}">{{ report.docker_repos }}/{{ report.non_empty_owned_repos }}</text>

  <line x1="24" y1="646" x2="268" y2="646" stroke="{{ theme.border }}" stroke-width="0.9"/>
  <text x="24" y="667" class="mono" font-size="9" fill="{{ theme.text_muted }}">Next Rank Milestone</text>
  <text x="268" y="667" text-anchor="end" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.accent_amber }}">{{ report.next_grade_hint }}</text>

  <!-- Panel 2: SECTOR ALLOCATION -->
  <rect x="288" y="546" width="264" height="140" rx="4" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <rect x="288" y="546" width="264" height="22" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="288" y1="568" x2="552" y2="568" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="298" y="561" class="sans" font-size="10" font-weight="800" letter-spacing="0.8" fill="{{ theme.text_primary }}">SECTOR ALLOCATION</text>
  <text x="542" y="561" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_amber }}">{{ earned_pips }}/{{ max_pips }} Pips</text>

  {% for sec in sector_rows %}
  {% set sy = 586 + loop.index0 * 18.2 %}
  <circle cx="302" cy="{{ sy - 3 }}" r="3.8" fill="{{ sec.accent }}"/>
  <text x="312" y="{{ sy }}" class="sans" font-size="9.5" font-weight="700" fill="{{ theme.text_primary }}">{{ sec.title }}</text>
  <rect x="424" y="{{ sy - 6 }}" width="72" height="5.5" rx="2" fill="{{ theme.bg_track }}"/>
  <rect x="424" y="{{ sy - 6 }}" width="{{ sec.fill_w }}" height="5.5" rx="2" fill="{{ sec.accent }}"/>
  <text x="542" y="{{ sy }}" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_muted }}">{{ sec.pips_label }}</text>
  {% endfor %}

  <!-- Panel 3: CAPSTONES & NODE TIERS -->
  <rect x="562" y="546" width="264" height="140" rx="4" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <rect x="562" y="546" width="264" height="22" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="562" y1="568" x2="826" y2="568" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="572" y="561" class="sans" font-size="10" font-weight="800" letter-spacing="0.8" fill="{{ theme.text_primary }}">CAPSTONES ◇</text>
  <text x="816" y="561" text-anchor="end" class="sans" font-size="10" font-weight="800" letter-spacing="0.8" fill="{{ theme.text_primary }}">NODE TIERS</text>

  <line x1="698" y1="574" x2="698" y2="678" stroke="{{ theme.border }}" stroke-width="1"/>

  {% for cap in capstone_rows %}
  {% set cy = 586 + loop.index0 * 18.2 %}
  <text x="572" y="{{ cy }}" class="sans" font-size="9.2" font-weight="600" fill="{{ theme.text_primary }}">{{ cap.name }}</text>
  <text x="690" y="{{ cy }}" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ cap.color }}">{{ cap.repos }}</text>
  {% endfor %}

  <text x="708" y="586" class="mono" font-size="8.8" fill="{{ theme.text_muted }}">Mastered</text>
  <text x="816" y="586" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_amber }}">{{ mastered_count }}</text>
  <text x="708" y="604" class="mono" font-size="8.8" fill="{{ theme.text_muted }}">Proficient</text>
  <text x="816" y="604" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_signal }}">{{ proficient_count }}</text>
  <text x="708" y="622" class="mono" font-size="8.8" fill="{{ theme.text_muted }}">Active</text>
  <text x="816" y="622" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_primary }}">{{ active_only_count }}</text>

  <line x1="708" y1="630" x2="816" y2="630" stroke="{{ theme.border }}" stroke-width="0.9"/>

  <text x="708" y="644" class="mono" font-size="8.8" fill="{{ theme.accent_amber }}">Legendary</text>
  <text x="816" y="644" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">{{ rarity_counts["LEGEND"] }}</text>
  <text x="708" y="661" class="mono" font-size="8.8" fill="{{ theme.accent_arcane }}">Epic</text>
  <text x="816" y="661" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">{{ rarity_counts["EPIC"] }}</text>
  <text x="708" y="678" class="mono" font-size="8.8" fill="{{ theme.accent_primary }}">Rare / Unc</text>
  <text x="816" y="678" text-anchor="end" class="mono" font-size="9" font-weight="700" fill="{{ theme.text_primary }}">{{ rarity_counts["RARE_UNC"] }}</text>
</svg>
