<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 336" width="840" height="336" role="img" aria-labelledby="battle-title-{{ mode }} battle-desc-{{ mode }}">
  <title id="battle-title-{{ mode }}">Episode {{ boss_index_1 }}: @{{ report.username }} vs {{ boss.name }} ({{ game.boss_hp }}/{{ boss.max_hp }} HP)</title>
  <desc id="battle-desc-{{ mode }}">Webcomic GBA RPG Boss Raid powered by GitHub Issues &amp; repository stars on @{{ report.username }}'s profile.</desc>
  <defs>
    <linearGradient id="gba-sky-{{ mode }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="{{ theme.sky_top }}"/>
      <stop offset="56%" stop-color="{{ theme.sky_bot }}"/>
      <stop offset="57%" stop-color="{{ theme.field_top }}"/>
      <stop offset="100%" stop-color="{{ theme.field_bot }}"/>
    </linearGradient>
    <clipPath id="gba-stage-clip-{{ mode }}">
      <rect x="14" y="38" width="812" height="212" rx="4"/>
    </clipPath>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .bob-enemy { animation: float-enemy 2.4s ease-in-out infinite; }
      .bob-ally { animation: float-ally 2.0s steps(2, end) infinite; }
      .cursor { animation: blink-cursor 1.1s steps(2, end) infinite; }
      .hp-danger { animation: pulse-danger 0.9s ease-in-out infinite; }
      .fx-pop { animation: float-enemy 1.8s ease-in-out infinite; }
      @keyframes float-enemy { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-3px); } }
      @keyframes float-ally { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-2px); } }
      @keyframes blink-cursor { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }
      @keyframes pulse-danger { 0%, 100% { opacity: 1; } 50% { opacity: 0.48; } }
    </style>
  </defs>

  <!-- Outer Comic GBA Frame -->
  <rect x="2" y="2" width="836" height="332" rx="6" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="4" y="4" width="832" height="28" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="4" y1="32" x2="836" y2="32" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <g shape-rendering="crispEdges">
    {% for r in header_ball %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <text x="32" y="22" class="sans" font-size="11.5" font-weight="700" fill="{{ theme.text_primary }}">Episode {{ boss_index_1 }} · Hero @{{ report.username }} vs {{ boss.name }}</text>
  <text x="822" y="22" text-anchor="end" class="mono" font-size="10" font-weight="600" fill="{{ theme.text_muted }}">Boss {{ boss_index_1 }}/{{ total_bosses }} · {{ game.bosses_slain }} K.O.'d · {{ game.total_raids }} Moves</text>

  <!-- Classic Diagonal GBA Battle Viewport -->
  <rect x="14" y="38" width="812" height="212" rx="4" fill="url(#gba-sky-{{ mode }})" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <g clip-path="url(#gba-stage-clip-{{ mode }})">
    <!-- Natural Rolling Horizon Hills -->
    <path d="M14,158 Q135,124 275,152 T545,146 T826,154 L826,162 L14,162 Z" fill="{{ theme.hill }}" opacity="0.65"/>
    <path d="M14,162 Q195,138 380,156 T720,148 L826,158 L826,166 L14,166 Z" fill="{{ theme.hill }}" opacity="0.9"/>

    {% if mode == "dark" %}
    <g shape-rendering="crispEdges" fill="{{ theme.text_subtle }}" opacity="0.65">
      <rect x="380" y="54" width="2" height="2"/><rect x="442" y="72" width="2" height="2"/>
      <rect x="504" y="48" width="2" height="2"/><rect x="774" y="60" width="2" height="2"/>
    </g>
    {% endif %}

    <!-- Per-Boss Atmospheric Stage Details -->
    {% if boss.key == "nullpointer_wyrm" %}
    <g shape-rendering="crispEdges" opacity="0.45">
      <rect x="556" y="70" width="12" height="2" fill="#EF4444"/><rect x="716" y="108" width="14" height="2" fill="#EF4444"/>
      <rect x="614" y="62" width="3" height="3" fill="#F59E0B"/><rect x="688" y="114" width="3" height="3" fill="#F43F5E"/>
    </g>
    {% elif boss.key == "merge_golem" %}
    <g shape-rendering="crispEdges" opacity="0.45">
      <rect x="552" y="114" width="10" height="3" fill="#FBBF24"/><rect x="718" y="84" width="10" height="3" fill="#38BDF8"/>
    </g>
    {% elif boss.key == "hallucination_phantom" %}
    <circle cx="636" cy="112" r="46" fill="{{ theme.accent_arcane }}" opacity="0.14"/>
    <circle cx="636" cy="112" r="32" fill="none" stroke="{{ theme.accent_arcane }}" stroke-width="1" stroke-dasharray="3,4" opacity="0.4"/>
    {% elif boss.key == "legacy_monolith" %}
    <g opacity="0.22" fill="{{ theme.border }}">
      <rect x="526" y="88" width="16" height="62" rx="1"/>
      <rect x="738" y="76" width="18" height="74" rx="1"/>
    </g>
    {% elif boss.key == "recursion_hydra" %}
    <circle cx="636" cy="114" r="50" fill="none" stroke="#F43F5E" stroke-width="1.2" stroke-dasharray="6,4" opacity="0.38"/>
    <circle cx="636" cy="114" r="38" fill="none" stroke="#FBBF24" stroke-width="1" stroke-dasharray="3,5" opacity="0.42"/>
    {% elif boss.key == "outage_titan" %}
    <path d="M736,46 L722,74 L734,74 L718,104" fill="none" stroke="#FBBF24" stroke-width="2" opacity="0.5"/>
    <circle cx="636" cy="112" r="46" fill="#38BDF8" opacity="0.12"/>
    {% endif %}

    <!-- Isometric Enemy Platform (Upper Right) -->
    <ellipse cx="636" cy="140" rx="88" ry="20" fill="{{ theme.plat_rim }}"/>
    <ellipse cx="636" cy="136" rx="82" ry="16" fill="{{ theme.plat_top }}" stroke="{{ theme.plat_hi }}" stroke-width="1.5"/>
    <ellipse cx="636" cy="138" rx="34" ry="6" fill="{{ theme.shadow }}" opacity="0.32"/>

    <!-- Isometric Player Platform (Lower Left) -->
    <ellipse cx="196" cy="222" rx="112" ry="24" fill="{{ theme.plat_rim }}"/>
    <ellipse cx="196" cy="217" rx="105" ry="20" fill="{{ theme.plat_top }}" stroke="{{ theme.plat_hi }}" stroke-width="1.5"/>
    <ellipse cx="162" cy="219" rx="25" ry="5" fill="{{ theme.shadow }}" opacity="0.32"/>
    <ellipse cx="234" cy="222" rx="21" ry="4.5" fill="{{ theme.shadow }}" opacity="0.28"/>
  </g>

  <!-- TOP-LEFT: Enemy HUD Box -->
  <path d="M30,48 L330,48 L330,104 L318,114 L30,114 Z" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="2"/>
  <path d="M34,52 L326,52 L326,102 L316,110 L34,110 Z" fill="none" stroke="{{ theme.border_hi }}" stroke-width="1" opacity="0.45"/>
  <text x="44" y="69" class="sans" font-size="12.5" font-weight="700" fill="{{ theme.text_primary }}">{{ boss.name }}</text>
  <text x="316" y="69" text-anchor="end" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.accent_amber }}">{{ boss_type }} · Lv{{ boss_level }}</text>

  <rect x="44" y="77" width="272" height="14" rx="4" fill="#1F2937" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="50" y="87" class="mono" font-size="9" font-weight="700" fill="#FBBF24">HP</text>
  <rect x="68" y="80" width="244" height="8" rx="2" fill="#374151"/>
  {% if boss_hp_width > 0 %}
  <rect class="{{ 'hp-danger' if boss_danger else '' }}" x="68" y="80" width="{{ boss_hp_width }}" height="8" rx="2" fill="{{ boss_hp_color }}"/>
  {% endif %}
  <text x="45" y="104" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_amber }}">★ STAR REPO = 1-HIT KO!</text>
  <text x="314" y="104" text-anchor="end" class="mono" font-size="10" font-weight="700" fill="{{ theme.text_primary }}">{{ game.boss_hp }}/{{ boss.max_hp }}</text>

  <!-- Compact Webcomic Boss Speech Bubble -->
  <path d="M472,62 L584,62 Q590,62 590,68 L590,82 Q590,88 584,88 L568,88 L576,97 L556,88 L472,88 Q466,88 466,82 L466,68 Q466,62 472,62 Z" fill="{{ theme.bg_panel }}" stroke="{{ theme.border_hi }}" stroke-width="1.3"/>
  <text x="528" y="79" text-anchor="middle" class="mono" font-size="9" font-weight="700" fill="{{ theme.accent_boss }}">{{ boss_quip }}</text>

  <!-- BOTTOM-RIGHT: Player HUD Box -->
  <path d="M482,172 L812,172 L812,240 L494,240 L482,230 Z" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="2"/>
  <path d="M486,176 L808,176 L808,236 L496,236 L486,228 Z" fill="none" stroke="{{ theme.border_hi }}" stroke-width="1" opacity="0.45"/>
  <text x="498" y="193" class="sans" font-size="12.5" font-weight="700" fill="{{ theme.text_primary }}">HERO · SARVESH</text>
  <text x="798" y="193" text-anchor="end" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_primary }}">Lv{{ report.level }}</text>

  <rect x="498" y="200" width="300" height="13" rx="4" fill="#1F2937" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="504" y="209.5" class="mono" font-size="8.5" font-weight="700" fill="#FBBF24">HP</text>
  <rect x="522" y="203" width="188" height="7" rx="2" fill="#22C55E"/>
  <text x="792" y="209.5" text-anchor="end" class="mono" font-size="8.5" font-weight="700" fill="#6EE7B7">POWER +{{ buff_charges * 10 }}</text>

  <text x="498" y="229" class="mono" font-size="9" fill="{{ theme.text_muted }}">{{ report.contributions_12m }}/yr · {{ "{:,}".format(report.xp) }} XP</text>
  <text x="652" y="229" text-anchor="end" class="mono" font-size="8" font-weight="700" fill="{{ theme.accent_primary }}">EXP</text>
  <rect x="658" y="223" width="140" height="5" rx="1.5" fill="{{ theme.bg_track }}"/>
  {% if exp_bar_width > 0 %}
  <rect x="658" y="223" width="{{ exp_bar_width }}" height="5" rx="1.5" fill="{{ theme.accent_primary }}"/>
  {% endif %}

  <!-- Natural Shaded 2px GBA Sprites -->
  <g class="bob-enemy" shape-rendering="crispEdges">
    {% for r in boss_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <!-- Dynamic Comic Impact SFX & Slash VFX -->
  {% if fx_kind == "star_ko" %}
  <g class="fx-pop">
    <path d="M594,142 L674,84" stroke="#FEF08A" stroke-width="4" stroke-linecap="round" opacity="0.85"/>
    <path d="M602,146 L682,88" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" opacity="0.9"/>
    <polygon points="750,62 762,74 782,66 778,84 798,94 776,102 780,118 760,110 746,122 742,104 720,98 738,84 732,68" fill="#FEF08A" stroke="#D97706" stroke-width="1.6"/>
    <text x="758" y="96" text-anchor="middle" class="mono" font-size="8.2" font-weight="800" fill="#78350F">{{ fx_label }}</text>
  </g>
  {% elif fx_kind == "crit" %}
  <g class="fx-pop">
    <path d="M594,144 L676,84" stroke="#F43F5E" stroke-width="4.5" stroke-linecap="round" opacity="0.85"/>
    <path d="M596,144 L674,86" stroke="#FEF08A" stroke-width="1.8" stroke-linecap="round"/>
    <polygon points="752,66 765,76 785,68 780,86 798,96 776,104 762,118 746,106 724,100 738,84" fill="#F43F5E" stroke="#FEF08A" stroke-width="1.4"/>
    <text x="760" y="96" text-anchor="middle" class="mono" font-size="8.2" font-weight="800" fill="#FFFFFF">{{ fx_label }}</text>
  </g>
  {% elif fx_kind == "strike" %}
  <g class="fx-pop">
    <path d="M598,140 L674,88" stroke="#38BDF8" stroke-width="3.5" stroke-linecap="round" opacity="0.85"/>
    <path d="M600,140 L672,90" stroke="#FFFFFF" stroke-width="1.4" stroke-linecap="round"/>
    <rect x="722" y="76" width="66" height="22" rx="4" fill="#0284C7" stroke="#BAE6FD" stroke-width="1.4"/>
    <text x="755" y="90.5" text-anchor="middle" class="mono" font-size="9" font-weight="800" fill="#FFFFFF">{{ fx_label }}</text>
  </g>
  {% endif %}
  {% if buff_charges > 0 %}
  <g class="cursor" shape-rendering="crispEdges" fill="{{ theme.accent_signal }}">
    <rect x="190" y="168" width="4" height="4"/>
    <rect x="258" y="184" width="4" height="4"/>
    <rect x="208" y="190" width="3" height="3" fill="{{ theme.accent_amber }}"/>
    <rect x="252" y="206" width="3" height="3" fill="{{ theme.accent_amber }}"/>
    <rect x="206" y="156" width="54" height="16" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.accent_signal }}" stroke-width="1.2"/>
    <text x="233" y="167" text-anchor="middle" class="mono" font-size="7.5" font-weight="700" fill="{{ theme.accent_signal }}">BUFF +{{ buff_charges * 10 }}</text>
  </g>
  {% endif %}
  <g class="bob-ally" shape-rendering="crispEdges">
    {% for r in hero_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
    {% for r in pet_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- BOTTOM SPLIT BAR: Comic Dialogue Box + 2x2 Move Selector -->
  <rect x="14" y="256" width="504" height="66" rx="5" fill="{{ theme.bg_dialog_rim }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="19" y="261" width="494" height="56" rx="3" fill="{{ theme.bg_dialog }}"/>
  <text x="32" y="280" class="sans" font-size="11.5" font-weight="700" fill="#F8FAFC">{{ event_line1 }}</text>
  {% if event_line2 %}
  <text x="32" y="296" class="sans" font-size="11.5" font-weight="700" fill="#F8FAFC">{{ event_line2 }}</text>
  {% endif %}
  <text x="32" y="311" class="mono" font-size="8.5" fill="#93C5FD">{{ battle_subline }}</text>

  <!-- Right 2x2 Comic Command Menu -->
  <rect x="526" y="256" width="300" height="66" rx="5" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="530" y="260" width="292" height="58" rx="3" fill="none" stroke="{{ theme.border_hi }}" stroke-width="1" opacity="0.45"/>

  <!-- Top-Left: Primary Attack (Active Selected) -->
  <rect x="535" y="264" width="138" height="23" rx="3" fill="{{ theme.bg_hud_inner }}" stroke="{{ theme.accent_boss }}" stroke-width="1.3"/>
  <text class="cursor mono" x="541" y="279" font-size="10" font-weight="700" fill="{{ theme.accent_boss }}">▶</text>
  <text x="553" y="279" class="mono" font-size="10" font-weight="700" fill="{{ theme.text_primary }}">STRIKE!</text>
  <text x="667" y="278.5" text-anchor="end" class="mono" font-size="8" font-weight="700" fill="{{ theme.accent_boss }}">16-44</text>

  <!-- Top-Right: Instant Star KO -->
  <rect x="679" y="264" width="138" height="23" rx="3" fill="{{ theme.bg_hud_inner }}" stroke="{{ theme.border }}" stroke-width="1.1"/>
  <rect x="681" y="267" width="3" height="17" rx="1" fill="{{ theme.accent_amber }}"/>
  <text x="689" y="279" class="mono" font-size="10" font-weight="700" fill="{{ theme.text_primary }}">★ STAR KO</text>
  <text x="811" y="278.5" text-anchor="end" class="mono" font-size="8" font-weight="700" fill="{{ theme.accent_amber }}">1-HIT</text>

  <!-- Bottom-Left: Buff Power Up -->
  <rect x="535" y="291" width="138" height="23" rx="3" fill="{{ theme.bg_hud_inner }}" stroke="{{ theme.border }}" stroke-width="1.1"/>
  <rect x="537" y="294" width="3" height="17" rx="1" fill="{{ theme.accent_signal }}"/>
  <text x="545" y="306" class="mono" font-size="10" font-weight="700" fill="{{ theme.text_primary }}">POWER UP</text>
  <text x="667" y="305.5" text-anchor="end" class="mono" font-size="8" font-weight="700" fill="{{ theme.accent_signal }}">+10 ATK</text>

  <!-- Bottom-Right: Tavern Guestbook -->
  <rect x="679" y="291" width="138" height="23" rx="3" fill="{{ theme.bg_hud_inner }}" stroke="{{ theme.border }}" stroke-width="1.1"/>
  <rect x="681" y="294" width="3" height="17" rx="1" fill="{{ theme.accent_primary }}"/>
  <text x="689" y="306" class="mono" font-size="10" font-weight="700" fill="{{ theme.text_primary }}">SAY HI!</text>
  <text x="811" y="305.5" text-anchor="end" class="mono" font-size="8" font-weight="700" fill="{{ theme.accent_primary }}">TAVERN</text>
</svg>
