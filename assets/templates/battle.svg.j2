<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 274" width="840" height="274" role="img" aria-labelledby="battle-title-{{ mode }} battle-desc-{{ mode }}">
  <title id="battle-title-{{ mode }}">Interactive RPG Dungeon Raid — {{ boss.name }} ({{ game.boss_hp }}/{{ boss.max_hp }} HP)</title>
  <desc id="battle-desc-{{ mode }}">Live GitHub Issues co-op boss fight on @{{ report.username }}'s profile.</desc>
  <defs>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .bob-hero { animation: bob 1.8s steps(2, end) infinite; }
      .bob-pet { animation: bob 1.4s steps(2, end) infinite; }
      .bob-boss { animation: boss-bob 2.2s steps(2, end) infinite; }
      .flicker { animation: torch 0.9s steps(2, end) infinite; }
      .twinkle-a { animation: twinkle 2.4s steps(2, end) infinite; }
      .twinkle-b { animation: twinkle 3.1s steps(2, end) 0.8s infinite; }
      @keyframes bob {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-3px); }
      }
      @keyframes boss-bob {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-4px); }
      }
      @keyframes torch {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.72; }
      }
      @keyframes twinkle {
        0%, 100% { opacity: 0.95; }
        50% { opacity: 0.3; }
      }
    </style>
  </defs>

  <!-- Outer Pixel Cartridge Border + Corner Rivets -->
  <rect x="2" y="2" width="836" height="270" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="2"/>
  <rect x="6" y="6" width="828" height="262" rx="2" fill="none" stroke="{{ theme.border_hi }}" stroke-width="1" opacity="0.45"/>
  <g shape-rendering="crispEdges" fill="{{ theme.accent_amber }}">
    <rect x="4" y="4" width="4" height="4"/><rect x="832" y="4" width="4" height="4"/>
    <rect x="4" y="266" width="4" height="4"/><rect x="832" y="266" width="4" height="4"/>
  </g>

  <!-- Top Chrome -->
  <rect x="6" y="6" width="828" height="28" fill="{{ theme.bg_panel }}"/>
  <line x1="6" y1="34" x2="834" y2="34" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <text x="18" y="24" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_amber }}" letter-spacing="0.8">DUNGEON RAID // LIVE VISITOR CO-OP</text>
  <text x="822" y="24" text-anchor="end" class="mono" font-size="10.5" font-weight="600" fill="{{ theme.text_muted }}">BOSSES SLAIN: {{ game.bosses_slain }} · RAID MOVES: {{ game.total_raids }}</text>

  <!-- Arena Stage Backdrop -->
  <rect x="16" y="42" width="808" height="162" rx="3" fill="{{ theme.bg_stage }}" stroke="{{ theme.border }}" stroke-width="1.5"/>

  <!-- Sky Celestial (Moon in dark, Sun + Cloud in light) & Twinkling Stars -->
  <g shape-rendering="crispEdges">
    {% for r in celestial_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
    {% for r in cloud_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  {% if mode == "dark" %}
  <g shape-rendering="crispEdges" fill="{{ theme.star }}">
    <rect class="twinkle-a" x="48" y="96" width="3" height="3"/>
    <rect class="twinkle-b" x="268" y="58" width="3" height="3"/>
    <rect class="twinkle-a" x="315" y="78" width="2" height="2"/>
    <rect class="twinkle-b" x="556" y="70" width="3" height="3"/>
    <rect class="twinkle-a" x="572" y="54" width="2" height="2"/>
    <rect class="twinkle-b" x="760" y="98" width="3" height="3"/>
  </g>
  {% endif %}

  <!-- Distant Stepped Pixel Battlement / Ruin Horizon -->
  <g shape-rendering="crispEdges" fill="{{ theme.horizon }}">
    <rect x="17" y="148" width="806" height="22"/>
    <rect x="26" y="136" width="24" height="12"/><rect x="64" y="140" width="18" height="8"/>
    <rect x="210" y="138" width="36" height="10"/><rect x="256" y="130" width="20" height="18"/>
    <rect x="288" y="140" width="26" height="8"/><rect x="524" y="138" width="30" height="10"/>
    <rect x="562" y="132" width="22" height="16"/><rect x="752" y="136" width="34" height="12"/>
  </g>

  <!-- Pixel Dungeon / Cobblestone Ground -->
  <rect x="17" y="170" width="806" height="33" fill="{{ theme.ground }}"/>
  <line x1="17" y1="170" x2="823" y2="170" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <g shape-rendering="crispEdges" fill="{{ theme.border }}" opacity="0.55">
    <rect x="30" y="180" width="32" height="3"/><rect x="92" y="191" width="36" height="3"/>
    <rect x="164" y="179" width="28" height="3"/><rect x="234" y="192" width="34" height="3"/>
    <rect x="318" y="182" width="38" height="3"/><rect x="412" y="190" width="32" height="3"/>
    <rect x="498" y="180" width="34" height="3"/><rect x="582" y="192" width="36" height="3"/>
    <rect x="668" y="181" width="30" height="3"/><rect x="748" y="191" width="34" height="3"/>
  </g>

  <!-- Flanking Animated Wall Torches -->
  <g class="flicker" shape-rendering="crispEdges">
    {% for r in torch_left_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
    {% for r in torch_right_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- LEFT: Hero Nameplate & Sprites -->
  <rect x="30" y="50" width="218" height="34" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="40" y="65" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_primary }}">SARVESH · LVL {{ report.level }}</text>
  <text x="40" y="78" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">BUFF +{{ game.hero_buff_charges * 10 }} DMG · {{ report.contributions_12m }} COMMITS/YR</text>

  <g class="bob-hero" shape-rendering="crispEdges">
    {% for r in hero_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <g class="bob-pet" shape-rendering="crispEdges">
    {% for r in pet_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- CENTER: Stage Crest & Spark -->
  <rect x="358" y="50" width="124" height="22" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="420" y="65" text-anchor="middle" class="mono" font-size="10.5" font-weight="700" fill="{{ theme.accent_signal }}">STAGE 0{{ boss_index_1 }} / 04</text>
  <g class="flicker" shape-rendering="crispEdges">
    {% for r in clash_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <text x="420" y="118" text-anchor="middle" class="mono" font-size="22" font-weight="700" fill="{{ theme.accent_amber }}">VS</text>
  <text x="420" y="140" text-anchor="middle" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">OPEN AN ISSUE MOVE BELOW TO FIGHT</text>
  <text x="420" y="155" text-anchor="middle" class="mono" font-size="9" fill="{{ theme.text_subtle }}">NEW GITHUB COMMITS AUTO-STRIKE BOSS</text>

  <!-- RIGHT: Boss Nameplate, HP Bar & Sprite -->
  <rect x="590" y="50" width="218" height="38" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.accent_boss }}" stroke-width="1.3"/>
  <text x="600" y="65" class="mono" font-size="10.5" font-weight="700" fill="{{ theme.accent_boss }}">{{ boss.name.upper() }}</text>
  <text x="800" y="65" text-anchor="end" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.text_primary }}">{{ game.boss_hp }}/{{ boss.max_hp }}</text>
  <rect x="600" y="73" width="198" height="8" rx="2" fill="{{ theme.bg_track }}"/>
  {% if boss_hp_width > 0 %}
  <rect x="600" y="73" width="{{ boss_hp_width }}" height="8" rx="2" fill="{{ theme.accent_boss }}"/>
  {% endif %}

  <g class="bob-boss" shape-rendering="crispEdges">
    {% for r in boss_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- BOTTOM: Combat Log & Tavern Ticker -->
  <rect x="16" y="212" width="808" height="48" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="28" y="231" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_amber }}">▶</text>
  <text x="43" y="231" class="sans" font-size="12" font-weight="600" fill="{{ theme.text_primary }}">{{ game.last_event }}</text>
  <text x="28" y="250" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">RAIDERS: {{ raiders_text }}</text>
  <text x="812" y="250" text-anchor="end" class="mono" font-size="9.5" fill="{{ theme.accent_signal }}">TAVERN: {{ tavern_text }}</text>
</svg>
