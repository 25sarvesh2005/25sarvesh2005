<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 304" width="840" height="304" role="img" aria-labelledby="battle-title-{{ mode }} battle-desc-{{ mode }}">
  <title id="battle-title-{{ mode }}">Boss Raid — {{ boss.name }} ({{ game.boss_hp }}/{{ boss.max_hp }} HP)</title>
  <desc id="battle-desc-{{ mode }}">Interactive GitHub Issues dungeon boss raid on @{{ report.username }}'s profile.</desc>
  <defs>
    <linearGradient id="arena-sky-{{ mode }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="{{ theme.bg_stage_top }}"/>
      <stop offset="100%" stop-color="{{ theme.bg_stage_bot }}"/>
    </linearGradient>
    <radialGradient id="aura-hero-{{ mode }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="{{ theme.accent_primary }}" stop-opacity="0.22"/>
      <stop offset="100%" stop-color="{{ theme.accent_primary }}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="aura-boss-{{ mode }}" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="{{ boss_accent }}" stop-opacity="0.24"/>
      <stop offset="100%" stop-color="{{ boss_accent }}" stop-opacity="0"/>
    </radialGradient>
    <clipPath id="arena-clip-{{ mode }}">
      <rect x="14" y="42" width="812" height="202" rx="3"/>
    </clipPath>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
      .bob-hero { animation: bob 1.8s steps(2, end) infinite; }
      .bob-pet { animation: bob 1.3s steps(2, end) infinite; }
      .bob-boss { animation: boss-bob 2.2s steps(2, end) infinite; }
      .flicker { animation: torch 0.8s steps(2, end) infinite; }
      .twinkle-a { animation: twinkle 2.4s steps(2, end) infinite; }
      .twinkle-b { animation: twinkle 3.1s steps(2, end) 0.8s infinite; }
      .hero-wave { animation: hwave 2.6s ease-in-out infinite; }
      .boss-wave { animation: bwave 2.6s ease-in-out infinite; }
      .clash-spark { animation: clash 2.6s steps(2, end) infinite; }
      @keyframes bob { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-4px); } }
      @keyframes boss-bob { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-4px); } }
      @keyframes torch { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }
      @keyframes twinkle { 0%, 100% { opacity: 0.9; } 50% { opacity: 0.25; } }
      @keyframes hwave {
        0% { transform: translateX(0px); opacity: 0.95; }
        42% { transform: translateX(148px); opacity: 0.95; }
        52%, 100% { transform: translateX(158px); opacity: 0; }
      }
      @keyframes bwave {
        0%, 48% { transform: translateX(0px); opacity: 0; }
        54% { transform: translateX(0px); opacity: 0.95; }
        92% { transform: translateX(-146px); opacity: 0.95; }
        100% { transform: translateX(-158px); opacity: 0; }
      }
      @keyframes clash {
        0%, 34%, 64%, 100% { opacity: 0; }
        42%, 56% { opacity: 1; }
      }
    </style>
  </defs>

  <!-- Outer Frame & Corner Rivets -->
  <rect x="2" y="2" width="836" height="300" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <g shape-rendering="crispEdges" fill="{{ theme.accent_amber }}">
    <rect x="6" y="6" width="4" height="4"/><rect x="830" y="6" width="4" height="4"/>
    <rect x="6" y="294" width="4" height="4"/><rect x="830" y="294" width="4" height="4"/>
  </g>

  <!-- Top Title Strip -->
  <rect x="3" y="3" width="834" height="31" fill="{{ theme.bg_panel }}"/>
  <line x1="3" y1="34" x2="837" y2="34" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="18" y="23" class="sans" font-size="12" font-weight="700" fill="{{ theme.text_primary }}">Boss Raid · Interactive Profile Game</text>
  <text x="822" y="23" text-anchor="end" class="mono" font-size="10.5" fill="{{ theme.text_muted }}">{{ game.bosses_slain }} Slain · Stage {{ boss_index_1 }}/4 · {{ game.total_raids }} Moves</text>

  <!-- Stage Backdrop -->
  <rect x="14" y="42" width="812" height="202" rx="3" fill="url(#arena-sky-{{ mode }})" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <g clip-path="url(#arena-clip-{{ mode }})">
    <ellipse cx="118" cy="176" rx="110" ry="70" fill="url(#aura-hero-{{ mode }})"/>
    <ellipse cx="706" cy="174" rx="116" ry="72" fill="url(#aura-boss-{{ mode }})"/>

    {% if mode == "dark" %}
    <g shape-rendering="crispEdges" fill="{{ theme.star }}">
      <rect class="twinkle-a" x="284" y="68" width="4" height="4"/>
      <rect class="twinkle-b" x="336" y="96" width="4" height="4"/>
      <rect class="twinkle-a" x="492" y="88" width="4" height="4"/>
      <rect class="twinkle-b" x="548" y="64" width="4" height="4"/>
    </g>
    {% endif %}
    <g shape-rendering="crispEdges">
      {% for r in celestial_rects %}
      <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
      {% endfor %}
      {% for r in cloud_rects %}
      <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
      {% endfor %}
    </g>

    <!-- Uniform 4px Stepped Dungeon Battlements -->
    <g shape-rendering="crispEdges" fill="{{ theme.horizon }}">
      <rect x="14" y="180" width="812" height="24"/>
      <rect x="200" y="168" width="40" height="12"/><rect x="252" y="160" width="24" height="20"/>
      <rect x="548" y="164" width="36" height="16"/><rect x="596" y="156" width="24" height="24"/>
    </g>

    <!-- Stone Sconce Pillars Anchoring Wall Torches -->
    <g shape-rendering="crispEdges" fill="{{ theme.horizon }}" stroke="{{ theme.border }}" stroke-width="1">
      <rect x="20" y="136" width="28" height="68"/>
      <rect x="792" y="136" width="28" height="68"/>
    </g>

    <!-- Solid Stone Floor (y=204..244) -->
    <rect x="14" y="204" width="812" height="40" fill="{{ theme.ground }}"/>
    <rect x="14" y="204" width="812" height="4" fill="{{ theme.ground_edge }}"/>
    <g shape-rendering="crispEdges" fill="{{ theme.ground_edge }}" opacity="0.55">
      <rect x="44" y="220" width="36" height="4"/><rect x="140" y="230" width="44" height="4"/>
      <rect x="256" y="218" width="32" height="4"/><rect x="384" y="228" width="48" height="4"/>
      <rect x="512" y="220" width="36" height="4"/><rect x="640" y="230" width="40" height="4"/>
      <rect x="748" y="218" width="32" height="4"/>
    </g>
  </g>

  <!-- Mounted Wall Torches -->
  <g class="flicker" shape-rendering="crispEdges">
    {% for r in torch_left_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
    {% for r in torch_right_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- Left HUD: Hero -->
  <rect x="24" y="50" width="230" height="44" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="34" y="67" class="sans" font-size="11.5" font-weight="700" fill="{{ theme.accent_primary }}">Sarvesh · Level {{ report.level }}</text>
  <text x="244" y="67" text-anchor="end" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">{{ report.contributions_12m }} commits/12m</text>
  <text x="34" y="84" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">Buff:</text>
  {% for slot in range(5) %}
  <rect x="{{ 68 + slot * 13 }}" y="76" width="9" height="9" rx="1" fill="{{ theme.accent_signal if slot < buff_charges else theme.bg_track }}" stroke="{{ theme.border }}" stroke-width="0.8"/>
  {% endfor %}
  <text x="138" y="84" class="mono" font-size="9.5" font-weight="600" fill="{{ theme.accent_signal }}">+{{ buff_charges * 10 }} DMG</text>

  <!-- Right HUD: Boss -->
  <rect x="586" y="50" width="230" height="44" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ boss_accent }}" stroke-width="1.3"/>
  <text x="598" y="67" class="sans" font-size="11.5" font-weight="700" fill="{{ boss_accent }}">{{ boss.name }}</text>
  <text x="804" y="67" text-anchor="end" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.text_primary }}">{{ game.boss_hp }}/{{ boss.max_hp }} HP</text>
  <rect x="598" y="76" width="206" height="8" rx="2" fill="{{ theme.bg_track }}"/>
  {% if boss_hp_width > 0 %}
  <rect x="598" y="76" width="{{ boss_hp_width }}" height="8" rx="2" fill="{{ boss_accent }}"/>
  {% endif %}

  <!-- Grounded Character Shadows (right at y=206) -->
  <ellipse cx="116" cy="206" rx="34" ry="4" fill="{{ theme.shadow }}" opacity="0.45"/>
  <ellipse cx="188" cy="206" rx="16" ry="3" fill="{{ theme.shadow }}" opacity="0.35"/>
  <ellipse cx="706" cy="206" rx="38" ry="4" fill="{{ theme.shadow }}" opacity="0.45"/>

  <!-- Side-View Hero (facing right), Optional Buff Halo & Companion -->
  {% if buff_charges > 0 %}
  <ellipse cx="116" cy="172" rx="46" ry="40" fill="none" stroke="{{ theme.accent_signal }}" stroke-width="1.5" stroke-dasharray="5 4" opacity="0.75"/>
  {% endif %}
  <g class="bob-hero" shape-rendering="crispEdges">
    {% for r in hero_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <g class="bob-pet" shape-rendering="crispEdges">
    {% for r in pet_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- Staggered 4px Pixel Waves & Center Impact Spark -->
  <g class="hero-wave" shape-rendering="crispEdges">
    {% for r in hero_wave_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <g class="boss-wave" shape-rendering="crispEdges">
    {% for r in boss_wave_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <g class="clash-spark" shape-rendering="crispEdges">
    {% for r in clash_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- Side-View Boss (facing left) -->
  <g class="bob-boss" shape-rendering="crispEdges">
    {% for r in boss_rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>

  <!-- Bottom Combat Log -->
  <rect x="14" y="250" width="812" height="44" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="26" y="268" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_amber }}">&gt;</text>
  <text x="40" y="268" class="sans" font-size="11.5" font-weight="600" fill="{{ theme.text_primary }}">{{ last_event_text }}</text>
  <text x="26" y="285" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">Party: {{ raiders_text }}</text>
  <text x="814" y="285" text-anchor="end" class="mono" font-size="9.5" fill="{{ theme.accent_signal }}">Guestbook: {{ tavern_text }}</text>
</svg>
