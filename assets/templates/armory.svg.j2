<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 208" width="840" height="208" role="img" aria-labelledby="armory-title-{{ mode }}">
  <title id="armory-title-{{ mode }}">Equipped Pixel Armory &amp; Engineering Stack — @{{ report.username }}</title>
  <defs>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
    </style>
  </defs>

  <!-- Outer Cartridge Frame -->
  <rect x="2" y="2" width="836" height="204" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="2"/>
  <g shape-rendering="crispEdges" fill="{{ theme.accent_arcane }}">
    <rect x="4" y="4" width="12" height="3"/><rect x="4" y="4" width="3" height="12"/>
    <rect x="824" y="4" width="12" height="3"/><rect x="833" y="4" width="3" height="12"/>
    <rect x="4" y="201" width="12" height="3"/><rect x="4" y="192" width="3" height="12"/>
    <rect x="824" y="201" width="12" height="3"/><rect x="833" y="192" width="3" height="12"/>
  </g>

  <!-- Top Chrome -->
  <rect x="6" y="6" width="828" height="28" fill="{{ theme.bg_panel }}"/>
  <line x1="6" y1="34" x2="834" y2="34" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <text x="18" y="24" class="mono" font-size="11" font-weight="700" fill="{{ theme.accent_arcane }}" letter-spacing="0.8">PIXEL ARMORY // EQUIPPED ENGINEERING LOADOUT</text>
  <text x="822" y="24" text-anchor="end" class="mono" font-size="10" font-weight="600" fill="{{ theme.text_muted }}">{{ report.languages_ge_1pct }} CORE LANGUAGES · {{ report.non_empty_owned_repos }} ACTIVE BUILDS</text>

  <!-- 2x2 RPG Inventory Quadrants -->
  {% for q in quadrants %}
  <rect x="{{ q.x }}" y="{{ q.y }}" width="{{ q.w }}" height="{{ q.h }}" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.3"/>
  <rect x="{{ q.x }}" y="{{ q.y }}" width="{{ q.w }}" height="3" rx="1" fill="{{ q.accent }}"/>
  <text x="{{ q.x + 12 }}" y="{{ q.y + 17 }}" class="mono" font-size="9.5" font-weight="700" fill="{{ q.accent }}">SLOT 0{{ q.idx }} // {{ q.title }}</text>
  {% for chip in q.chips %}
  <rect x="{{ chip.x }}" y="{{ chip.y }}" width="{{ chip.w }}" height="18" rx="2" fill="{{ theme.bg_chip }}" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="{{ chip.x + chip.w / 2 }}" y="{{ chip.y + 12.5 }}" text-anchor="middle" class="mono" font-size="9" font-weight="600" fill="{{ theme.text_primary }}">{{ chip.label }}</text>
  {% endfor %}
  {% endfor %}
</svg>
