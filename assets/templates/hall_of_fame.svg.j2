<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 208" width="840" height="208" role="img" aria-labelledby="hof-title-{{ mode }} hof-desc-{{ mode }}">
  <title id="hof-title-{{ mode }}">Hero Guild Board &amp; Tavern Guestbook — @{{ report.username }}</title>
  <desc id="hof-desc-{{ mode }}">Live Star Boss Slayers leaderboard, highest raid damage record, and visitor guestbook notes on @{{ report.username }}.</desc>
  <defs>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    </style>
  </defs>

  <!-- Outer Guild Board Frame -->
  <rect x="2" y="2" width="836" height="204" rx="6" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.8"/>
  <rect x="4" y="4" width="832" height="30" rx="3" fill="{{ theme.bg_panel }}"/>
  <line x1="4" y1="34" x2="836" y2="34" stroke="{{ theme.border }}" stroke-width="1.2"/>

  <g shape-rendering="crispEdges">
    {% for r in header_ball %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <text x="32" y="23" class="sans" font-size="11.5" font-weight="800" fill="{{ theme.text_primary }}">HERO GUILD BOARD · STAR SLAYERS &amp; TAVERN WALL</text>
  <text x="822" y="23" text-anchor="end" class="mono" font-size="9.5" font-weight="700" fill="{{ theme.accent_amber }}">{{ game.bosses_slain }} K.O.'d · {{ star_finisher_count }} ★ Star Slayers · {{ game.total_raids }} Moves</text>

  <!-- LEFT PANE: Star Finishers & Combat Records -->
  <rect x="14" y="42" width="370" height="154" rx="4" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <text x="26" y="60" class="mono" font-size="9.5" font-weight="800" fill="{{ theme.accent_amber }}">★ 1-HIT STAR FINISHERS</text>
  <text x="372" y="60" text-anchor="end" class="mono" font-size="8.5" fill="{{ theme.text_muted }}">Star repo = Instant KO badge</text>

  {% if star_chips %}
    {% for chip in star_chips %}
    <rect x="{{ chip.x }}" y="{{ chip.y }}" width="{{ chip.w }}" height="20" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.accent_amber }}" stroke-width="1.1"/>
    <text x="{{ chip.x + 8 }}" y="{{ chip.y + 13.5 }}" class="mono" font-size="8.8" font-weight="700" fill="{{ theme.accent_amber }}">★ @{{ chip.handle }}</text>
    {% endfor %}
  {% else %}
    <rect x="26" y="70" width="346" height="44" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-dasharray="3,3" stroke-width="1"/>
    <text x="199" y="96" text-anchor="middle" class="mono" font-size="9" font-weight="600" fill="{{ theme.text_muted }}">No external ★ Star Finishers yet — click ★ Star to claim #1!</text>
  {% endif %}

  <!-- Records Box -->
  <rect x="26" y="130" width="346" height="54" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="36" y="147" class="mono" font-size="8.5" font-weight="700" fill="{{ theme.accent_boss }}">RECORD CRIT:</text>
  <text x="362" y="147" text-anchor="end" class="mono" font-size="8.5" font-weight="700" fill="{{ theme.text_primary }}">{{ best_hit_text }}</text>
  <line x1="36" y1="156" x2="362" y2="156" stroke="{{ theme.border }}" stroke-width="0.8"/>
  <text x="36" y="172" class="mono" font-size="8.5" font-weight="700" fill="{{ theme.accent_primary }}">LATEST KO:</text>
  <text x="362" y="172" text-anchor="end" class="mono" font-size="8.5" fill="{{ theme.text_muted }}">{{ latest_ko_text }}</text>

  <!-- RIGHT PANE: Tavern Guestbook Speech Bubbles (Up to 4 Visitor Notes) -->
  <rect x="394" y="42" width="432" height="154" rx="4" fill="{{ theme.bg_hud }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <text x="406" y="60" class="mono" font-size="9.5" font-weight="800" fill="{{ theme.accent_primary }}">TAVERN GUESTBOOK</text>
  <text x="814" y="60" text-anchor="end" class="mono" font-size="8.5" fill="{{ theme.text_muted }}">Click "Say Hi!" above to sign</text>

  {% for slot in tavern_slots %}
  <rect x="406" y="{{ slot.y }}" width="408" height="28" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.accent_primary if slot.filled else theme.border }}" stroke-width="{{ 1.1 if slot.filled else 0.8 }}" opacity="{{ 1 if slot.filled else 0.55 }}"/>
  <text x="416" y="{{ slot.y + 17.5 }}" class="mono" font-size="8.8" font-weight="700" fill="{{ theme.accent_primary if slot.filled else theme.text_subtle }}">{{ slot.author }}</text>
  <text x="530" y="{{ slot.y + 17.5 }}" class="sans" font-size="9.2" font-weight="600" fill="{{ theme.text_primary if slot.filled else theme.text_subtle }}">{{ slot.note }}</text>
  <text x="804" y="{{ slot.y + 17.5 }}" text-anchor="end" class="mono" font-size="8" fill="{{ theme.text_muted }}">{{ slot.issue }}</text>
  {% endfor %}
</svg>
