<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 264" width="840" height="264" role="img" aria-labelledby="trainer-title-{{ mode }} trainer-desc-{{ mode }}">
  <title id="trainer-title-{{ mode }}">Engineering Telemetry &amp; Milestones — {{ report.display_name }} (@{{ report.username }})</title>
  <desc id="trainer-desc-{{ mode }}">Level {{ report.level }} {{ report.level_title }} with {{ report.xp }} XP, {{ report.contributions_12m }} trailing 12-month contributions, and {{ report.unlocked_count }} earned milestones.</desc>
  <defs>
    <clipPath id="trainer-xp-clip-{{ mode }}">
      <rect x="26" y="72" width="266" height="7" rx="2"/>
    </clipPath>
    <clipPath id="trainer-lang-clip-{{ mode }}">
      <rect x="26" y="226" width="266" height="8" rx="2"/>
    </clipPath>
    <style>
      .mono { font-family: ui-monospace, SFMono-Regular, "Cascadia Mono", Menlo, Consolas, monospace; }
      .sans { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    </style>
  </defs>

  <!-- Outer Frame -->
  <rect x="2" y="2" width="836" height="260" rx="4" fill="{{ theme.bg_card }}" stroke="{{ theme.border }}" stroke-width="1.5"/>
  <g shape-rendering="crispEdges" fill="{{ theme.accent_primary }}">
    <rect x="6" y="6" width="4" height="4"/><rect x="830" y="6" width="4" height="4"/>
    <rect x="6" y="254" width="4" height="4"/><rect x="830" y="254" width="4" height="4"/>
  </g>

  <!-- Header Chrome -->
  <rect x="3" y="3" width="834" height="31" fill="{{ theme.bg_panel }}"/>
  <line x1="3" y1="34" x2="837" y2="34" stroke="{{ theme.border }}" stroke-width="1"/>
  <text x="18" y="23" class="sans" font-size="12" font-weight="700" fill="{{ theme.text_primary }}">GitHub Telemetry &amp; Earned Milestones</text>
  <text x="822" y="23" text-anchor="end" class="mono" font-size="10.5" fill="{{ theme.text_muted }}">Level {{ report.level }} ({{ report.level_title }}) · {{ "{:,}".format(report.xp) }} XP · Synced {{ sync_date }}</text>

  <!-- LEFT PANE: Readable Engineering Snapshot -->
  <rect x="14" y="42" width="290" height="208" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>

  <text x="26" y="63" class="sans" font-size="11.5" font-weight="700" fill="{{ theme.accent_primary }}">Level {{ report.level }} → {{ report.level + 1 }}</text>
  <text x="292" y="63" text-anchor="end" class="mono" font-size="9.5" fill="{{ theme.text_muted }}">{{ report.xp_in_level }} / {{ report.xp_for_next_level }} XP</text>
  <rect x="26" y="72" width="266" height="7" rx="2" fill="{{ theme.bg_track }}"/>
  {% if xp_bar_width > 0 %}
  <rect x="26" y="72" width="{{ xp_bar_width }}" height="7" rx="2" fill="{{ theme.accent_primary }}"/>
  {% endif %}

  <line x1="26" y1="88" x2="292" y2="88" stroke="{{ theme.border }}" stroke-width="1" opacity="0.7"/>

  {% set rows = [
    ("12-Month Contribs", "{:,}".format(report.contributions_12m) ~ " (" ~ "{:,}".format(report.total_contributions) ~ " total)"),
    ("Active Coding Days", report.active_days ~ " days (" ~ report.longest_streak ~ "d streak)"),
    ("Peak Output Day", report.peak_day_contributions ~ " commits"),
    ("CI & Docs", report.ci_repos ~ " CI · " ~ report.documented_repos ~ " READMEs"),
    ("PRs & Stars", report.merged_prs ~ " merged · " ~ report.external_stars ~ " stars")
  ] %}
  {% for label, value in rows %}
  {% set ry = 106 + loop.index0 * 21 %}
  <text x="26" y="{{ ry }}" class="sans" font-size="10.5" fill="{{ theme.text_muted }}">{{ label }}</text>
  <text x="292" y="{{ ry }}" text-anchor="end" class="mono" font-size="10.5" font-weight="700" fill="{{ theme.text_primary }}">{{ value }}</text>
  {% endfor %}

  <text x="26" y="218" class="mono" font-size="8.5" fill="{{ theme.text_muted }}">
    {%- for lang in report.top_languages[:3] -%}
      {{ lang.name }} {{ lang.percentage }}%{% if not loop.last %} · {% endif %}
    {%- endfor -%}
  </text>
  <rect x="26" y="226" width="266" height="8" rx="2" fill="{{ theme.bg_track }}"/>
  <g clip-path="url(#trainer-lang-clip-{{ mode }})">
    {% for seg in lang_segments %}
    <rect x="{{ 26 + seg.x }}" y="226" width="{{ seg.width }}" height="8" fill="{{ seg.color }}"/>
    {% endfor %}
  </g>

  <!-- RIGHT PANE: 3x3 Earned Milestones Wall -->
  <rect x="314" y="42" width="512" height="208" rx="3" fill="{{ theme.bg_panel }}" stroke="{{ theme.border }}" stroke-width="1.2"/>
  <text x="326" y="61" class="sans" font-size="11.5" font-weight="700" fill="{{ theme.text_primary }}">Earned Milestones</text>
  <text x="814" y="61" text-anchor="end" class="mono" font-size="9.5" fill="{{ theme.accent_signal }}">{{ report.unlocked_count }} of {{ report.total_quests }} quests unlocked</text>

  {% for tile in badge_tiles %}
  <rect x="{{ tile.x }}" y="{{ tile.y }}" width="{{ tile.w }}" height="{{ tile.h }}" rx="3" fill="{{ theme.bg_canvas }}" stroke="{{ theme.accent_amber if tile.unlocked else theme.border }}" stroke-width="{{ 1.3 if tile.unlocked else 1 }}"/>
  <g shape-rendering="crispEdges">
    {% for r in tile.rects %}
    <rect x="{{ r.x }}" y="{{ r.y }}" width="{{ r.w }}" height="{{ r.h }}" fill="{{ r.fill }}"/>
    {% endfor %}
  </g>
  <text x="{{ tile.x + 46 }}" y="{{ tile.y + 23 }}" class="sans" font-size="10.5" font-weight="700" fill="{{ theme.text_primary if tile.unlocked else theme.text_muted }}">{{ tile.title }}</text>
  <text x="{{ tile.x + 46 }}" y="{{ tile.y + 38 }}" class="mono" font-size="9" fill="{{ theme.accent_signal if tile.unlocked else theme.text_subtle }}">{{ tile.sub }}</text>
  {% if not tile.unlocked %}
  <rect x="{{ tile.x + 46 }}" y="{{ tile.y + 44 }}" width="106" height="2.5" rx="1" fill="{{ theme.bg_track }}"/>
  {% if tile.progress_w > 0 %}
  <rect x="{{ tile.x + 46 }}" y="{{ tile.y + 44 }}" width="{{ tile.progress_w * 0.94 }}" height="2.5" rx="1" fill="{{ theme.accent_primary }}"/>
  {% endif %}
  {% endif %}
  {% endfor %}
</svg>
